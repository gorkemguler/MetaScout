# Google Programmable Search Engine (https://programmablesearchengine.google.com/)
# GOOGLE_API_KEY can be a single key, or multiple comma-separated keys (e.g.
# from separate GCP projects sharing the same GOOGLE_CSE_ID) to automatically
# rotate to the next one when one runs out of its 100-queries/day quota.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Brave Search API (https://brave.com/search/api/)
BRAVE_API_KEY=
