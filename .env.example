# Google Programmable Search Engine (https://programmablesearchengine.google.com/)
# GOOGLE_API_KEY can be a single key, or multiple comma-separated keys (e.g.
# from separate GCP projects sharing the same GOOGLE_CSE_ID) to automatically
# rotate to the next one when one runs out of its 100-queries/day quota.
# NOTE: Google is discontinuing this API on 2027-01-01 and already rejects
# newly created Google Cloud projects (PERMISSION_DENIED regardless of
# configuration). If it doesn't work for you, use SERPER_API_KEY below instead.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Serper.dev (https://serper.dev) — a third-party API that returns real Google
# search results as JSON. Free credit is available on signup; check the site
# for the current amount since it changes. Recommended in place of Google's
# own API above, which is being shut down.
SERPER_API_KEY=

# Brave Search API (https://brave.com/search/api/)
BRAVE_API_KEY=
